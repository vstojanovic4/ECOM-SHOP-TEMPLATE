{%- liquid
  assign s = section.settings
-%}

<section class="style-grid full-width">
  <div class="style-grid__box" style="background: {{ s.bg_color }};">

    {%- if s.heading != blank -%}
      <h2 class="style-grid__heading">{{ s.heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    <ul class="style-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="style-grid__item" {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a class="style-grid__card" href="{{ b.link }}">{%- else -%}<div class="style-grid__card">{%- endif -%}

            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(max-width: 989px) 100vw, 700px', loading: 'lazy', class: 'style-grid__img', alt: b.label, style: 'object-position: right top;' }}
            {%- endif -%}
            <span class="style-grid__label">{{ b.label | escape }}</span>

          {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
  .style-grid {
    padding: 80px 0;
  }
  .style-grid__box {
    width: min(1240px, 100% - 32px);
    margin: 0 auto;
    padding: 70px 64px 76px;
    border-radius: 40px;
  }
  .style-grid__heading {
    margin: 0 0 64px;
    font-family: var(--font-heading);
    font-stretch: 106%;
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    color: #000;
    text-align: center;
    text-transform: uppercase;
  }

  /* Raspored: uska-široka / široka-uska (ponavlja se na svake 4 kartice) */
  .style-grid__list {
    display: grid;
    grid-template-columns: 407fr 257fr 407fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .style-grid__item:nth-child(4n + 2),
  .style-grid__item:nth-child(4n + 3) {
    grid-column: span 2;
  }

  .style-grid__card {
    position: relative;
    display: block;
    height: 289px;
    overflow: hidden;
    border-radius: 20px;
    background: #fff;
    color: #000;
    text-decoration: none;
  }
  .style-grid__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  a.style-grid__card:hover .style-grid__img {
    transform: scale(1.04);
  }
  .style-grid__label {
    position: absolute;
    top: 25px;
    left: 36px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.35;
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .style-grid {
      padding: 50px 0;
    }
    .style-grid__box {
      padding: 40px 24px 27px;
      border-radius: 20px;
    }
    .style-grid__heading {
      margin-bottom: 28px;
      font-size: 32px;
    }
    .style-grid__list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .style-grid__item:nth-child(4n + 2),
    .style-grid__item:nth-child(4n + 3) {
      grid-column: auto;
    }
    .style-grid__card {
      height: 190px;
    }
    .style-grid__label {
      top: 16px;
      left: 24px;
      font-size: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stilovi (Dress Style)",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Naslov", "default": "Browse by dress style", "info": "Enter = novi red." },
    { "type": "color", "id": "bg_color", "label": "Pozadina kartice", "default": "#f0f0f0" }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Stil",
      "settings": [
        { "type": "text", "id": "label", "label": "Naziv", "default": "Casual" },
        { "type": "image_picker", "id": "image", "label": "Slika", "info": "Slika se poravnava uz desni gornji ugao kartice." },
        { "type": "url", "id": "link", "label": "Link", "info": "Npr. kolekcija tog stila." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stilovi (Dress Style)",
      "blocks": [
        { "type": "style", "settings": { "label": "Casual" } },
        { "type": "style", "settings": { "label": "Formal" } },
        { "type": "style", "settings": { "label": "Party" } },
        { "type": "style", "settings": { "label": "Gym" } }
      ]
    }
  ]
}
{% endschema %}
