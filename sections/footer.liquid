{%- liquid
  assign s = section.settings
-%}

<footer class="site-footer full-width" style="--footer-bg: {{ s.bg_color }};">

  {%- comment -%} Newsletter (crna kartica koja "preklapa" gornju ivicu footera) {%- endcomment -%}
  {%- if s.show_newsletter -%}
    <div class="site-footer__newsletter">
      <h2 class="site-footer__newsletter-heading">{{ s.newsletter_heading | escape | newline_to_br }}</h2>

      {%- form 'customer', class: 'site-footer__form', id: 'footer-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="site-footer__form-message">{{ s.newsletter_success | escape }}</p>
        {%- else -%}
          <label class="site-footer__field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            <span class="visually-hidden">E-mail</span>
            <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.newsletter_placeholder | escape }}">
          </label>
          {%- if form.errors -%}
            <p class="site-footer__form-message">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <button type="submit" class="site-footer__submit">{{ s.newsletter_button | escape }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="site-footer__main">
    {%- comment -%} Kolona sa logom, opisom i društvenim mrežama {%- endcomment -%}
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" class="site-footer__logo">{{ s.logo_text | default: shop.name | escape }}</a>
      {%- if s.description != blank -%}
        <p class="site-footer__description">{{ s.description | escape }}</p>
      {%- endif -%}

      <ul class="site-footer__socials" role="list">
        {%- if s.twitter_url != blank -%}
          <li><a href="{{ s.twitter_url }}" aria-label="Twitter" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 4.6a9.2 9.2 0 0 1-2.6.7 4.6 4.6 0 0 0 2-2.5 9.2 9.2 0 0 1-2.9 1.1 4.6 4.6 0 0 0-7.8 4.2A13 13 0 0 1 2.2 3.3a4.6 4.6 0 0 0 1.4 6.1 4.5 4.5 0 0 1-2.1-.6v.1a4.6 4.6 0 0 0 3.7 4.5 4.6 4.6 0 0 1-2 .1 4.6 4.6 0 0 0 4.3 3.2A9.2 9.2 0 0 1 .7 18.6a13 13 0 0 0 7.1 2.1c8.4 0 13-7 13-13v-.6A9.3 9.3 0 0 0 23 4.6z" fill="currentColor"/></svg></a></li>
        {%- endif -%}
        {%- if s.facebook_url != blank -%}
          <li><a href="{{ s.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4 1.7-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8.5c0-.3.2-.5.5-.5z" fill="currentColor"/></svg></a></li>
        {%- endif -%}
        {%- if s.instagram_url != blank -%}
          <li><a href="{{ s.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg></a></li>
        {%- endif -%}
        {%- if s.github_url != blank -%}
          <li><a href="{{ s.github_url }}" aria-label="GitHub" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z" fill="currentColor"/></svg></a></li>
        {%- endif -%}
      </ul>
    </div>

    {%- comment -%} Kolone sa linkovima (blokovi) {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="site-footer__column" {{ block.shopify_attributes }}>
        <h3 class="site-footer__column-heading">{{ b.heading | escape }}</h3>
        <ul class="site-footer__links" role="list">
          {%- if b.menu != blank -%}
            {%- for link in b.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Dok se ne izabere meni, prikazuju se primeri iz dizajna {%- endcomment -%}
            {%- liquid
              case b.heading
                when 'Company'
                  assign demo_links = 'About|Features|Works|Career'
                when 'Help'
                  assign demo_links = 'Customer Support|Delivery Details|Terms & Conditions|Privacy Policy'
                when 'FAQ'
                  assign demo_links = 'Account|Manage Deliveries|Orders|Payments'
                when 'Resources'
                  assign demo_links = 'Free eBooks|Development Tutorial|How to - Blog|Youtube Playlist'
                else
                  assign demo_links = ''
              endcase
              assign demo_links = demo_links | split: '|'
            -%}
            {%- for title in demo_links -%}
              <li><span>{{ title | escape }}</span></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copyright">{{ s.copyright | escape }}</p>

    {%- if s.show_payment_icons -%}
      {%- assign payment_types = shop.enabled_payment_types -%}
      {%- if payment_types.size == 0 -%}
        {%- assign payment_types = 'visa,master,paypal,apple_pay,google_pay' | split: ',' -%}
      {%- endif -%}
      <ul class="site-footer__payments" role="list">
        {%- for type in payment_types -%}
          <li class="site-footer__payment">{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    --footer-inner: min(1240px, 100% - 32px);
    margin-top: auto;
    padding-bottom: 80px;
    /* Gornjih 90px je bele boje, pa newsletter kartica "visi" preko ivice */
    background: linear-gradient(to bottom, transparent 90px, var(--footer-bg) 90px);
  }
  .site-footer .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* ---------- Newsletter ---------- */
  .site-footer__newsletter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    width: var(--footer-inner);
    margin: 0 auto 50px;
    padding: 36px 64px;
    border-radius: 20px;
    background: #000;
    color: #fff;
  }
  .site-footer__newsletter-heading {
    max-width: 551px;
    margin: 0;
    font-family: var(--font-heading);
    font-stretch: 106%;
    font-size: 40px;
    font-weight: 800;
    line-height: 45px;
    color: #fff;
    text-transform: uppercase;
  }
  .site-footer__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 349px;
    flex-shrink: 0;
  }
  .site-footer__field {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 16px;
    border-radius: 62px;
    background: #fff;
    color: rgba(0, 0, 0, 0.4);
  }
  .site-footer__field svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .site-footer__field input {
    flex: 1;
    min-width: 0;
    border: 0;
    border-radius: 0;
    outline: 0;
    background: none;
    color: #000;
    font-size: 16px;
  }
  .site-footer__field input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }
  .site-footer__submit {
    height: 46px;
    border: 0;
    border-radius: 62px;
    background: #fff;
    color: #000;
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }
  .site-footer__form-message {
    margin: 0;
    font-size: 14px;
    color: #fff;
  }

  /* ---------- Glavni deo ---------- */
  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 248px) repeat(4, auto);
    justify-content: space-between;
    gap: 40px;
    width: var(--footer-inner);
    margin: 0 auto;
    padding-bottom: 50px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .site-footer__logo {
    display: inline-block;
    margin-bottom: 25px;
    font-family: var(--font-heading);
    font-stretch: 106%;
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    color: #000;
    text-decoration: none;
    text-transform: uppercase;
  }
  .site-footer__description {
    margin: 0 0 35px;
    font-size: 14px;
    line-height: 22px;
    color: rgba(0, 0, 0, 0.6);
  }
  .site-footer__socials {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    background: #fff;
    color: #000;
    transition: background 0.2s, color 0.2s;
  }
  .site-footer__socials a:hover {
    border-color: #000;
    background: #000;
    color: #fff;
  }
  .site-footer__socials svg {
    width: 13px;
    height: 13px;
  }

  .site-footer__column-heading {
    margin: 10px 0 26px;
    font-size: 16px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: 3px;
    color: #000;
    text-transform: uppercase;
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 19px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 16px;
    line-height: 19px;
    color: rgba(0, 0, 0, 0.6);
  }
  .site-footer__links a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer__links a:hover {
    color: #000;
  }

  /* ---------- Donji red ---------- */
  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: var(--footer-inner);
    margin: 0 auto;
    padding-top: 20px;
  }
  .site-footer__copyright {
    margin: 0;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.6);
  }
  .site-footer__payments {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__payment {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 30px;
    border: 1px solid #d6dce5;
    border-radius: 5px;
    background: #fff;
  }
  .site-footer__payment svg {
    width: 34px;
    height: auto;
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .site-footer {
      padding-bottom: 40px;
      background: linear-gradient(to bottom, transparent 135px, var(--footer-bg) 135px);
    }
    .site-footer__newsletter {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      margin-bottom: 50px;
      padding: 32px 24px 28px;
    }
    .site-footer__newsletter-heading {
      font-size: 32px;
      line-height: 35px;
    }
    .site-footer__form {
      width: 100%;
      gap: 12px;
    }
    .site-footer__field {
      height: 42px;
    }
    .site-footer__field input,
    .site-footer__submit {
      font-size: 14px;
    }
    .site-footer__submit {
      height: 42px;
    }

    .site-footer__main {
      grid-template-columns: 1fr 1fr;
      gap: 24px 16px;
      padding-bottom: 40px;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
      margin-bottom: 4px;
    }
    .site-footer__logo {
      margin-bottom: 14px;
      font-size: 28px;
    }
    .site-footer__description {
      margin-bottom: 20px;
    }
    .site-footer__column-heading {
      margin: 0 0 16px;
      font-size: 14px;
      line-height: 16px;
    }
    .site-footer__links {
      gap: 16px;
      font-size: 14px;
      line-height: 16px;
    }
    .site-footer__bottom {
      flex-direction: column;
      gap: 16px;
      padding-top: 16px;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Pozadina footera", "default": "#f0f0f0" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Prikaži newsletter", "default": true },
    { "type": "textarea", "id": "newsletter_heading", "label": "Naslov", "default": "Stay upto date about our latest offers" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Tekst u polju za e-mail", "default": "Enter your email address" },
    { "type": "text", "id": "newsletter_button", "label": "Tekst dugmeta", "default": "Subscribe to Newsletter" },
    { "type": "text", "id": "newsletter_success", "label": "Poruka posle prijave", "default": "Thanks for subscribing!" },
    { "type": "header", "content": "Logo i opis" },
    { "type": "text", "id": "logo_text", "label": "Tekst loga", "default": "SHOP.CO" },
    { "type": "textarea", "id": "description", "label": "Opis", "default": "We have clothes that suits your style and which you're proud to wear. From women to men." },
    { "type": "header", "content": "Društvene mreže", "info": "Ikonica se prikazuje samo ako je upisan link." },
    { "type": "url", "id": "twitter_url", "label": "Twitter" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "github_url", "label": "GitHub" },
    { "type": "header", "content": "Donji red" },
    { "type": "text", "id": "copyright", "label": "Copyright tekst", "default": "Shop.co © 2000-2023, All Rights Reserved" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Kolona linkova",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Naslov", "default": "Company" },
        { "type": "link_list", "id": "menu", "label": "Meni", "info": "Napravi meni u Online Store → Navigation." }
      ]
    }
  ]
}
{% endschema %}
