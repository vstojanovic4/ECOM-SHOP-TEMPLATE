{% comment %}
  Tabovi ispod proizvoda: Product Details / Rating & Reviews / FAQs.
  - Product Details: opis proizvoda
  - Rating & Reviews: mesto za app blok (Judge.me "Review Widget")
  - FAQs: pitanja i odgovori (blokovi)
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
-%}

<div class="pdp-tabs full-width" data-pdp-tabs>
  <div class="pdp-tabs__inner">

    <div class="pdp-tabs__list" role="tablist">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign tab_key = 'details'
              assign tab_label = s.details_label
            when 2
              assign tab_key = 'reviews'
              assign tab_label = s.reviews_label
            when 3
              assign tab_key = 'faqs'
              assign tab_label = s.faqs_label
          endcase
        -%}
        <button
          type="button"
          role="tab"
          class="pdp-tabs__tab"
          id="{{ section.id }}-tab-{{ tab_key }}"
          aria-controls="{{ section.id }}-panel-{{ tab_key }}"
          aria-selected="{% if s.default_tab == tab_key %}true{% else %}false{% endif %}"
          data-tab="{{ tab_key }}"
        >
          {{- tab_label | escape -}}
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%} Product Details {%- endcomment -%}
    <div class="pdp-tabs__panel" role="tabpanel" id="{{ section.id }}-panel-details" aria-labelledby="{{ section.id }}-tab-details"{% unless s.default_tab == 'details' %} hidden{% endunless %}>
      <div class="pdp-tabs__details">
        {%- if product.description != blank -%}
          {{ product.description }}
        {%- else -%}
          <p>{{ s.details_empty | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Rating & Reviews (Judge.me) {%- endcomment -%}
    <div class="pdp-tabs__panel" role="tabpanel" id="{{ section.id }}-panel-reviews" aria-labelledby="{{ section.id }}-tab-reviews"{% unless s.default_tab == 'reviews' %} hidden{% endunless %}>
      {%- for block in app_blocks -%}
        {% render block %}
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="pdp-tabs__hint">Dodaj blok „Review Widget“ iz aplikacije Judge.me u ovu sekciju (Add block → Apps).</p>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} FAQs {%- endcomment -%}
    <div class="pdp-tabs__panel" role="tabpanel" id="{{ section.id }}-panel-faqs" aria-labelledby="{{ section.id }}-tab-faqs"{% unless s.default_tab == 'faqs' %} hidden{% endunless %}>
      <div class="pdp-tabs__faqs">
        {%- for block in faq_blocks -%}
          <details class="pdp-tabs__faq" {{ block.shopify_attributes }}>
            <summary class="pdp-tabs__question">
              {{- block.settings.question | escape -}}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pdp-tabs__answer">{{ block.settings.answer }}</div>
          </details>
        {%- else -%}
          {%- if request.design_mode -%}
            <p class="pdp-tabs__hint">Dodaj pitanja kao blokove „FAQ“ (Add block → FAQ).</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

{% stylesheet %}
  .pdp-tabs__inner {
    width: min(1240px, 100% - 32px);
    margin: 0 auto;
    padding: 80px 0;
  }

  /* ---------- Tabovi ---------- */
  .pdp-tabs__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .pdp-tabs__tab {
    margin-bottom: -1px;
    padding: 0 0 24px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: rgba(0, 0, 0, 0.6);
    font: inherit;
    font-size: 20px;
    cursor: pointer;
  }
  .pdp-tabs__tab:hover {
    color: #000;
  }
  .pdp-tabs__tab[aria-selected='true'] {
    border-bottom-color: #000;
    color: #000;
    font-weight: 500;
  }

  .pdp-tabs__panel[hidden] {
    display: none;
  }
  .pdp-tabs__hint {
    padding: 24px;
    border: 1px dashed rgba(0, 0, 0, 0.2);
    border-radius: 20px;
    color: rgba(0, 0, 0, 0.6);
    text-align: center;
  }

  /* ---------- Product Details ---------- */
  .pdp-tabs__details {
    max-width: 800px;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.6);
  }
  .pdp-tabs__details > * + * {
    margin-top: 12px;
  }

  /* ---------- FAQs ---------- */
  .pdp-tabs__faq {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .pdp-tabs__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 18px;
    font-weight: 500;
    color: #000;
    list-style: none;
    cursor: pointer;
  }
  .pdp-tabs__question::-webkit-details-marker {
    display: none;
  }
  .pdp-tabs__question svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.2s;
  }
  .pdp-tabs__faq[open] .pdp-tabs__question svg {
    transform: rotate(180deg);
  }
  .pdp-tabs__answer {
    padding-bottom: 20px;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.6);
  }
  .pdp-tabs__answer p {
    margin: 0;
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .pdp-tabs__inner {
      padding: 50px 0;
    }
    /* Tabovi se prevlače levo-desno */
    .pdp-tabs__list {
      display: flex;
      gap: 32px;
      margin-bottom: 20px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .pdp-tabs__tab {
      flex-shrink: 0;
      padding-bottom: 12px;
      font-size: 16px;
      white-space: nowrap;
    }
    .pdp-tabs__details,
    .pdp-tabs__answer {
      font-size: 14px;
    }
    .pdp-tabs__question {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-pdp-tabs]').forEach((root) => {
    const tabs = root.querySelectorAll('[role="tab"]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((other) => {
          const selected = other === tab;
          other.setAttribute('aria-selected', selected);
          root.querySelector(`#${other.getAttribute('aria-controls')}`).hidden = !selected;
        });
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Tabovi proizvoda",
  "settings": [
    {
      "type": "select",
      "id": "default_tab",
      "label": "Tab otvoren na početku",
      "options": [
        { "value": "details", "label": "Product Details" },
        { "value": "reviews", "label": "Rating & Reviews" },
        { "value": "faqs", "label": "FAQs" }
      ],
      "default": "reviews"
    },
    { "type": "text", "id": "details_label", "label": "Naziv taba: detalji", "default": "Product Details" },
    { "type": "text", "id": "reviews_label", "label": "Naziv taba: recenzije", "default": "Rating & Reviews" },
    { "type": "text", "id": "faqs_label", "label": "Naziv taba: pitanja", "default": "FAQs" },
    { "type": "text", "id": "details_empty", "label": "Tekst kad proizvod nema opis", "default": "No details yet." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Pitanje", "default": "How do I choose my size?" },
        { "type": "richtext", "id": "answer", "label": "Odgovor", "default": "<p>Check the size guide and compare the measurements with a shirt you already own.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Tabovi proizvoda" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
