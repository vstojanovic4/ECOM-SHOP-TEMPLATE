{%- liquid
  assign menu_items = section.blocks
-%}

{%- capture icon_search -%}
  <svg class="header-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7.25" stroke="currentColor" stroke-width="1.8"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
{%- endcapture -%}

{%- capture icon_chevron -%}
  <svg class="header-svg header-svg--small" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcapture -%}

{%- capture search_form -%}
  <form action="{{ routes.search_url }}" method="get" role="search" class="header-search">
    <label class="header-search__field">
      {{ icon_search }}
      <span class="visually-hidden">{{ section.settings.search_placeholder | escape }}</span>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}">
    </label>
  </form>
{%- endcapture -%}

<header class="site-header full-width" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="site-header__inner">

    {%- comment -%} Hamburger (samo mobilni) {%- endcomment -%}
    <details class="header-drawer" data-header-details>
      <summary class="header-icon" aria-label="Meni">
        <svg class="header-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </summary>
      <nav class="header-drawer__panel" aria-label="Meni">
        <ul class="header-drawer__list" role="list">
          {%- for block in menu_items -%}
            <li><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a></li>
            {%- for child in block.settings.submenu.links -%}
              <li class="header-drawer__child"><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </nav>
    </details>

    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="header-logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'header-logo__img' }}
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name | escape }}
      {%- endif -%}
    </a>

    {%- comment -%} Meni (desktop) {%- endcomment -%}
    <nav class="header-nav" aria-label="Glavni meni">
      <ul class="header-nav__list" role="list">
        {%- for block in menu_items -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.submenu.links.size > 0 -%}
              <details class="header-dropdown" data-header-details>
                <summary class="header-nav__link">{{ block.settings.label | escape }} {{ icon_chevron }}</summary>
                <ul class="header-dropdown__list" role="list">
                  {%- for child in block.settings.submenu.links -%}
                    <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="header-nav__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Pretraga (desktop) {%- endcomment -%}
    <div class="header-search-desktop">{{ search_form }}</div>

    {%- comment -%} Ikonice {%- endcomment -%}
    <div class="header-icons">
      <details class="header-search-mobile" data-header-details>
        <summary class="header-icon" aria-label="Pretraga">{{ icon_search }}</summary>
        <div class="header-search-mobile__panel">{{ search_form }}</div>
      </details>

      <a href="{{ routes.cart_url }}" class="header-icon" aria-label="Korpa">
        <svg class="header-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 3h2.4l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h9.3a1.5 1.5 0 0 0 1.5-1.1L21 7H5.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.5" fill="currentColor"/><circle cx="17.5" cy="20" r="1.5" fill="currentColor"/></svg>
        {%- if cart.item_count > 0 -%}<span class="header-cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>

      <a href="{{ routes.account_url }}" class="header-icon" aria-label="Nalog">
        <svg class="header-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9.6" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="3.4" stroke="currentColor" stroke-width="1.8"/><path d="M6.2 18.6c1.3-2 3.4-3.1 5.8-3.1s4.5 1.1 5.8 3.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
    </div>

  </div>
</header>

<script>
  // Zatvara otvoren meni/pretragu kada se klikne van njega
  document.addEventListener('click', function (event) {
    document.querySelectorAll('[data-header-details][open]').forEach(function (details) {
      if (!details.contains(event.target)) details.removeAttribute('open');
    });
  });
</script>

{% stylesheet %}
  .site-header a {
    color: inherit;
    text-decoration: none;
  }
  .site-header summary {
    list-style: none;
    cursor: pointer;
  }
  .site-header summary::-webkit-details-marker {
    display: none;
  }
  .site-header .header-svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .site-header .header-svg--small {
    width: 16px;
    height: 16px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    width: min(1240px, 100% - 32px);
    margin: 0 auto;
    padding: 24px 0;
  }

  /* Logo */
  .header-logo {
    flex-shrink: 0;
    margin-right: 40px;
    font-family: var(--font-heading);
    font-stretch: 106%;
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .header-logo__img {
    display: block;
    width: 160px;
    height: auto;
  }

  /* Meni */
  .header-nav__list {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header-nav__link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 16px;
    white-space: nowrap;
  }
  .header-dropdown {
    position: relative;
  }
  .header-dropdown__list {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    z-index: 10;
    min-width: 180px;
    margin: 0;
    padding: 8px 0;
    list-style: none;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
  }
  .header-dropdown__list a {
    display: block;
    padding: 8px 16px;
  }

  /* Pretraga */
  .header-search-desktop {
    flex: 1;
    max-width: 577px;
    margin-left: 40px;
  }
  .header-search__field {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 16px;
    background: #f0f0f0;
    border-radius: 62px;
    color: rgba(0, 0, 0, 0.4);
  }
  .header-search__field input {
    flex: 1;
    min-width: 0;
    border: 0;
    border-radius: 0;
    background: none;
    outline: none;
    font-size: 16px;
    color: #000;
  }
  .header-search__field input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  /* Ikonice */
  .header-icons {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
    padding-left: 40px;
  }
  .header-icon {
    position: relative;
    display: flex;
  }
  .header-cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: #000;
    color: #fff;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
  }

  /* Elementi samo za mobilni */
  .header-drawer,
  .header-search-mobile {
    display: none;
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .site-header__inner {
      padding: 20px 0;
    }
    .header-nav,
    .header-search-desktop {
      display: none;
    }
    .header-drawer,
    .header-search-mobile {
      display: block;
    }
    .header-logo {
      margin: 0 0 0 16px;
      font-size: 25px;
    }
    .header-logo__img {
      width: 126px;
    }
    .header-icons {
      gap: 12px;
      padding-left: 16px;
    }

    .header-drawer__panel,
    .header-search-mobile__panel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 10;
      padding: 8px 0 16px;
      background: #fff;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }
    .header-drawer__list {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .header-drawer__list a {
      display: block;
      padding: 10px 0;
      font-size: 18px;
    }
    .header-drawer__child a {
      padding-left: 16px;
      font-size: 16px;
      color: rgba(0, 0, 0, 0.6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Tekst loga", "default": "SHOP.CO" },
    { "type": "image_picker", "id": "logo", "label": "Logo slika (opciono)", "info": "Ako dodaš sliku, ona se prikazuje umesto teksta." },
    { "type": "text", "id": "search_placeholder", "label": "Tekst u pretrazi", "default": "Search for products..." },
    { "type": "color", "id": "bg_color", "label": "Pozadina", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Boja teksta", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Stavka menija",
      "settings": [
        { "type": "text", "id": "label", "label": "Naziv", "default": "Link" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "link_list", "id": "submenu", "label": "Padajući meni (opciono)" }
      ]
    }
  ]
}
{% endschema %}
