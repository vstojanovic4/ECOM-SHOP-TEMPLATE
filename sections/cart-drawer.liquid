{% comment %}
  Global cart drawer, rendered from layout/theme.liquid.
  Opens from the header cart icon and after any add to cart.
  Quantity changes and add to cart use the Section Rendering API (no page reload).
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

<cart-drawer data-section-id="{{ section.id }}">
  <dialog class="cart-drawer" aria-labelledby="CartDrawerTitle" data-drawer>
    <div class="cart-drawer__panel">
      <div class="cart-drawer__content" data-drawer-content data-count="{{ cart.item_count }}">
        <div class="cart-drawer__header">
          <h2 class="cart-drawer__title" id="CartDrawerTitle">
            {{- s.heading | escape -}}
            {%- if cart.item_count > 0 %} <span class="cart-drawer__count">({{ cart.item_count }})</span>{% endif -%}
          </h2>
          <button type="button" class="cart-drawer__close" aria-label="Close cart" data-drawer-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>

        <p class="cart-drawer__error" role="alert" data-drawer-error hidden></p>

        {%- if cart.item_count > 0 -%}
          {%- if s.show_free_shipping -%}
            <div class="cart-drawer__shipping">
              {%- render 'free-shipping-bar',
                threshold: s.free_shipping_threshold,
                text: s.free_shipping_text,
                success_text: s.free_shipping_success,
                popup_text: s.free_shipping_popup,
                color: s.free_shipping_color
              -%}
            </div>
          {%- endif -%}

          <ul class="cart-drawer__items" role="list">
            {%- for item in cart.items -%}
              {%- liquid
                assign line = forloop.index
                assign qty_minus = item.quantity | minus: 1
                assign qty_plus = item.quantity | plus: 1
              -%}
              <li class="cart-drawer-item">
                <a class="cart-drawer-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: widths: '100, 200', sizes: '100px', loading: 'lazy', class: 'cart-drawer-item__img', alt: '' }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'cart-drawer-item__img' }}
                  {%- endif -%}
                </a>

                <div class="cart-drawer-item__info">
                  <div class="cart-drawer-item__top">
                    <a class="cart-drawer-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                    <button
                      type="button"
                      class="cart-drawer-item__remove"
                      aria-label="Remove {{ item.product.title | escape }}"
                      data-drawer-change
                      data-action="remove"
                      data-line="{{ line }}"
                      data-quantity="0"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l1 2h4v2H4V5h4l1-2zm-3 6h12l-1 12H7L6 9zm4 2v8h1.5v-8H10zm3.5 0v8H15v-8h-1.5z" fill="currentColor"/></svg>
                    </button>
                  </div>

                  {%- unless item.product.has_only_default_variant -%}
                    <dl class="cart-drawer-item__options">
                      {%- for option in item.options_with_values -%}
                        <div><dt>{{ option.name | escape }}:</dt> <dd>{{ option.value | escape }}</dd></div>
                      {%- endfor -%}
                    </dl>
                  {%- endunless -%}

                  {% render 'cart-selling-plan', item: item, line: line, id_prefix: 'CartDrawerPlan' %}

                  {%- liquid
                    # A subscription discount is part of the price, so compare with the regular price
                    assign compare_line = item.original_line_price
                    if item.selling_plan_allocation.compare_at_price > item.selling_plan_allocation.price
                      assign compare_line = item.selling_plan_allocation.compare_at_price | times: item.quantity
                    endif
                  -%}
                  <div class="cart-drawer-item__bottom">
                    <div class="cart-drawer-item__price">
                      {%- if compare_line > item.final_line_price -%}
                        <s>{{ compare_line | money_without_trailing_zeros }}</s>
                      {%- endif -%}
                      <span>{{ item.final_line_price | money_without_trailing_zeros }}</span>
                    </div>

                    <div class="cart-drawer-item__qty">
                      <button
                        type="button"
                        class="cart-drawer-item__qty-btn"
                        aria-label="Decrease quantity of {{ item.product.title | escape }}"
                        data-drawer-change
                        data-action="minus"
                        data-line="{{ line }}"
                        data-quantity="{{ qty_minus }}"
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                      </button>
                      <span class="cart-drawer-item__qty-value">
                        <span class="visually-hidden">Quantity:</span> {{ item.quantity }}
                      </span>
                      <button
                        type="button"
                        class="cart-drawer-item__qty-btn"
                        aria-label="Increase quantity of {{ item.product.title | escape }}"
                        data-drawer-change
                        data-action="plus"
                        data-line="{{ line }}"
                        data-quantity="{{ qty_plus }}"
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <div class="cart-drawer__footer">
            {%- assign cart_discount = cart.original_total_price | minus: cart.total_price -%}
            {%- if cart_discount > 0 -%}
              <div class="cart-drawer__row">
                <span>Discount</span>
                <span class="cart-drawer__discount">-{{ cart_discount | money_without_trailing_zeros }}</span>
              </div>
            {%- endif -%}

            <div class="cart-drawer__row cart-drawer__row--total">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money_without_trailing_zeros }}</span>
            </div>

            {%- if s.note != blank -%}
              <p class="cart-drawer__note">{{ s.note | escape }}</p>
            {%- endif -%}

            <form action="{{ routes.cart_url }}" method="post">
              <button type="submit" name="checkout" class="cart-drawer__checkout">
                {{ s.checkout_label | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m0 0l-7-7m7 7l-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>
          </div>
        {%- else -%}
          <div class="cart-drawer__empty">
            <p>{{ s.empty_text | escape }}</p>
            <a class="cart-drawer__continue" href="{{ routes.all_products_collection_url }}">{{ s.continue_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </dialog>
</cart-drawer>

{% stylesheet %}
  /* Lock page scroll but keep the scrollbar space, so the page does not jump sideways */
  html.cart-drawer-open {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .cart-drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .cart-drawer::backdrop {
    background: rgb(0 0 0 / 0);
    transition: background 0.35s ease;
  }
  .cart-drawer.is-open::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(440px, 100%);
    height: 100%;
    background: #fff;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
  }
  .cart-drawer.is-open .cart-drawer__panel {
    transform: none;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cart-drawer__content[aria-busy='true'] .cart-drawer__items,
  .cart-drawer__content[aria-busy='true'] .cart-drawer__footer {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.15s;
  }

  .cart-drawer .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Header */
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .cart-drawer__title {
    margin: 0;
    font-family: var(--font-heading);
    font-stretch: 106%;
    font-size: 24px;
    font-weight: 800;
    line-height: 1;
    color: #000;
    text-transform: uppercase;
  }
  .cart-drawer__count {
    font-family: var(--font-primary--family);
    font-size: 16px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
  }
  .cart-drawer__close {
    display: flex;
    padding: 4px;
    border: 0;
    background: none;
    color: #000;
    cursor: pointer;
  }
  .cart-drawer__close svg {
    width: 24px;
    height: 24px;
  }

  .cart-drawer__error {
    margin: 16px 24px 0;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(255, 51, 51, 0.1);
    color: #f33;
    font-size: 14px;
  }
  .cart-drawer__error[hidden] {
    display: none;
  }

  .cart-drawer__shipping {
    padding: 16px 24px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  /* Items */
  .cart-drawer__items {
    flex: 1;
    margin: 0;
    padding: 0 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
  }
  .cart-drawer-item {
    display: flex;
    gap: 14px;
    padding: 20px 0;
  }
  .cart-drawer-item + .cart-drawer-item {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .cart-drawer-item__media {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    overflow: hidden;
    border-radius: 9px;
    background: #f0eeed;
  }
  .cart-drawer-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-drawer-item__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .cart-drawer-item__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .cart-drawer-item__title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: #000;
    text-decoration: none;
  }
  .cart-drawer-item__remove {
    flex-shrink: 0;
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    color: #f33;
    cursor: pointer;
  }
  .cart-drawer-item__remove svg {
    width: 20px;
    height: 20px;
  }
  .cart-drawer-item__options {
    margin: 2px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: #000;
  }
  .cart-drawer-item__options div {
    display: flex;
    gap: 4px;
  }
  .cart-drawer-item__options dd {
    margin: 0;
    color: rgba(0, 0, 0, 0.6);
  }
  .cart-drawer-item__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
  }
  .cart-drawer-item__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: 18px;
    font-weight: 700;
    color: #000;
  }
  .cart-drawer-item__price s {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.4);
  }
  .cart-drawer-item__qty {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    width: 105px;
    height: 36px;
    padding: 0 6px;
    border-radius: 62px;
    background: #f0f0f0;
  }
  .cart-drawer-item__qty-btn {
    display: flex;
    padding: 4px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: #000;
    cursor: pointer;
  }
  .cart-drawer-item__qty-btn svg {
    width: 16px;
    height: 16px;
  }
  .cart-drawer-item__qty-value {
    font-size: 14px;
    font-weight: 500;
  }

  /* Footer */
  .cart-drawer__footer {
    padding: 20px 24px 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .cart-drawer__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 16px;
    color: rgba(0, 0, 0, 0.6);
  }
  .cart-drawer__row + .cart-drawer__row {
    margin-top: 12px;
  }
  .cart-drawer__row--total {
    font-size: 20px;
    font-weight: 700;
    color: #000;
  }
  .cart-drawer__discount {
    font-weight: 700;
    color: #f33;
  }
  .cart-drawer__note {
    margin: 8px 0 0;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.6);
  }
  .cart-drawer__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    height: 56px;
    margin-top: 20px;
    border: 0;
    border-radius: 62px;
    background: #000;
    color: #fff;
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }
  .cart-drawer__checkout svg {
    width: 24px;
    height: 24px;
  }

  /* Empty cart */
  .cart-drawer__empty {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    color: rgba(0, 0, 0, 0.6);
  }
  .cart-drawer__empty p {
    margin: 0;
  }
  .cart-drawer__continue {
    display: inline-flex;
    align-items: center;
    height: 52px;
    margin-top: 20px;
    padding: 0 48px;
    border-radius: 62px;
    background: #000;
    color: #fff;
    font-weight: 500;
    text-decoration: none;
  }

  .cart-drawer :focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
  .cart-drawer__checkout:focus-visible,
  .cart-drawer__continue:focus-visible {
    outline-offset: 3px;
  }

  /* Error under an add to cart form */
  .cart-add-error {
    margin: 12px 0 0;
    color: #f33;
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer::backdrop,
    .cart-drawer__panel {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cart-drawer')) {
    class CartDrawer extends HTMLElement {
      connectedCallback() {
        this.dialog = this.querySelector('[data-drawer]');
        if (!this.dialog) return;

        this.abort = new AbortController();
        const options = { signal: this.abort.signal };

        // Header cart icon (keeps its /cart href as a fallback without JS)
        document.addEventListener('click', (event) => {
          const toggle = event.target.closest('[data-cart-drawer-toggle]');
          if (!toggle) return;
          event.preventDefault();
          this.open();
        }, options);

        // Every add to cart form on the site
        document.addEventListener('submit', (event) => this.onAddToCart(event), options);

        this.addEventListener('click', (event) => {
          // A click on the dialog itself = a click on the dark backdrop
          if (event.target === this.dialog || event.target.closest('[data-drawer-close]')) {
            this.close();
            return;
          }
          const button = event.target.closest('[data-drawer-change]');
          if (button) this.changeLine(button);
        }, options);

        this.addEventListener('change', (event) => {
          const select = event.target.closest('[data-cart-plan]');
          if (select) this.changePlan(select);
        }, options);

        // Escape key: close with the slide-out animation
        this.dialog.addEventListener('cancel', (event) => {
          event.preventDefault();
          this.close();
        }, options);
      }

      disconnectedCallback() {
        this.abort?.abort();
        clearTimeout(this.closeTimer);
        document.documentElement.classList.remove('cart-drawer-open');
      }

      get root() {
        return window.Shopify?.routes?.root || '/';
      }

      // Drawer + the cart page section, when we are on /cart
      get sectionIds() {
        const ids = [this.dataset.sectionId];
        const page = document.querySelector('[data-cart]');
        if (page?.dataset.sectionId) ids.push(page.dataset.sectionId);
        return ids;
      }

      open() {
        clearTimeout(this.closeTimer);
        if (!this.dialog.open) this.dialog.showModal();
        document.documentElement.classList.add('cart-drawer-open');
        // Two frames so the slide-in transition runs after the dialog is shown
        requestAnimationFrame(() => {
          requestAnimationFrame(() => this.dialog.classList.add('is-open'));
        });

        // The cart page changes the cart on its own, so refresh the drawer there
        if (document.querySelector('[data-cart]')) this.refresh();
      }

      close() {
        if (!this.dialog.open) return;
        this.dialog.classList.remove('is-open');
        this.closeTimer = setTimeout(() => {
          this.dialog.close();
          document.documentElement.classList.remove('cart-drawer-open');
        }, 350);
      }

      async refresh() {
        try {
          const response = await fetch(`${this.root}?sections=${this.dataset.sectionId}`);
          if (response.ok) this.render(await response.json());
        } catch (error) {
          // Keep the current content if the request fails
        }
      }

      // Replace the drawer content (and the cart page, if present) with fresh HTML
      render(sections) {
        if (!sections) return;

        const drawerHtml = sections[this.dataset.sectionId];
        if (drawerHtml) {
          const doc = new DOMParser().parseFromString(drawerHtml, 'text/html');
          const fresh = doc.querySelector('[data-drawer-content]');
          const current = this.querySelector('[data-drawer-content]');
          if (fresh && current) {
            current.replaceWith(fresh);
            this.updateCount(Number(fresh.dataset.count));
          }
        }

        const page = document.querySelector('[data-cart]');
        const pageHtml = page && sections[page.dataset.sectionId];
        if (pageHtml) {
          const doc = new DOMParser().parseFromString(pageHtml, 'text/html');
          const freshPage = doc.querySelector('[data-cart]');
          if (freshPage) page.replaceWith(freshPage);
        }
      }

      updateCount(count) {
        if (Number.isNaN(count)) return;
        document.querySelectorAll('[data-cart-count]').forEach((badge) => {
          badge.textContent = count;
          badge.hidden = count === 0;
        });
      }

      showError(message) {
        const error = this.querySelector('[data-drawer-error]');
        if (!error) return;
        error.textContent = message || 'Something went wrong. Please try again.';
        error.hidden = false;
      }

      changeLine(button) {
        const line = Number(button.dataset.line);
        const quantity = Number(button.dataset.quantity);
        const action = button.dataset.action;

        this.sendChange({ line, quantity }, () => {
          // Keep keyboard focus on the same button; if the item is gone, go to the close button
          const sameButton = quantity > 0
            && this.querySelector(`[data-drawer-change][data-line="${line}"][data-action="${action}"]`);
          (sameButton || this.querySelector('[data-drawer-close]'))?.focus();
        });
      }

      // One-time purchase <-> subscription; an empty value removes the selling plan
      changePlan(select) {
        const line = Number(select.dataset.line);
        this.sendChange(
          { line, quantity: Number(select.dataset.quantity), selling_plan: select.value || null },
          () => this.querySelector(`[data-cart-plan][data-line="${line}"]`)?.focus(),
        );
      }

      async sendChange(change, restoreFocus) {
        if (this.busy) return;
        this.busy = true;
        this.querySelector('[data-drawer-content]')?.setAttribute('aria-busy', 'true');

        try {
          const response = await fetch(`${this.root}cart/change.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              ...change,
              sections: this.sectionIds,
              sections_url: window.location.pathname,
            }),
          });
          const data = await response.json();

          // e.g. not enough stock: Shopify returns a message and the cart stays the same
          if (!response.ok) {
            this.showError(data.description || data.message);
            return;
          }

          this.render(data.sections);
          restoreFocus();
        } catch (error) {
          this.showError();
        } finally {
          this.busy = false;
          this.querySelector('[data-drawer-content]')?.removeAttribute('aria-busy');
        }
      }

      async onAddToCart(event) {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (!(form.getAttribute('action') || '').includes('/cart/add')) return;
        event.preventDefault();

        const submitter = event.submitter;
        if (submitter?.disabled || form.dataset.adding) return;
        form.dataset.adding = 'true';
        submitter?.setAttribute('aria-busy', 'true');
        form.querySelector('[data-cart-add-error]')?.remove();

        const formData = new FormData(form);
        formData.append('sections', this.sectionIds.join(','));
        formData.append('sections_url', window.location.pathname);

        try {
          const response = await fetch(`${this.root}cart/add.js`, {
            method: 'POST',
            headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: formData,
          });
          const data = await response.json();

          if (!response.ok) {
            const error = document.createElement('p');
            error.className = 'cart-add-error';
            error.setAttribute('role', 'alert');
            error.dataset.cartAddError = '';
            error.textContent = data.description || data.message || 'Could not add to cart. Please try again.';
            form.append(error);
            return;
          }

          this.render(data.sections);
          this.open();
        } catch (error) {
          // Network problem: fall back to the normal form submit (goes to /cart)
          form.submit();
        } finally {
          delete form.dataset.adding;
          submitter?.removeAttribute('aria-busy');
        }
      }
    }

    customElements.define('cart-drawer', CartDrawer);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "text", "id": "note", "label": "Note below the subtotal", "default": "Taxes and shipping calculated at checkout." },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Go to Checkout" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your cart is empty." },
    { "type": "text", "id": "continue_label", "label": "Empty cart button", "default": "Continue shopping" },
    { "type": "header", "content": "Free shipping bar" },
    { "type": "checkbox", "id": "show_free_shipping", "label": "Show free shipping bar", "default": true },
