{%- liquid
  assign s = section.settings
  assign products = s.collection.products
-%}

{%- comment -%} Jedna zvezdica (puna); pola zvezdice se dobija sečenjem sloja {%- endcomment -%}
{%- capture star -%}
  <svg viewBox="0 0 20 19" aria-hidden="true"><path d="M10 0l2.94 6.06 6.56.92-4.79 4.62 1.17 6.56L10 15.04 4.12 18.16l1.17-6.56L.5 6.98l6.56-.92L10 0z" fill="currentColor"/></svg>
{%- endcapture -%}

<section class="product-row full-width">
  <div class="product-row__inner">

    {%- if s.heading != blank -%}
      <h2 class="product-row__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}

    <ul class="product-row__list" role="list">
      {%- if s.collection != blank and products.size > 0 -%}
        {%- for product in products limit: s.products_count -%}
          {%- liquid
            assign rating = product.metafields.reviews.rating.value
            assign discount = 0
            if product.compare_at_price > product.price
              assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif
          -%}
          <li class="product-row__card">
            <a class="product-row__link" href="{{ product.url }}">
              <div class="product-row__media">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 989px) 198px, 295px', loading: 'lazy', class: 'product-row__img' }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'product-row__img' }}
                {%- endif -%}
              </div>

              <h3 class="product-row__title">{{ product.title | escape }}</h3>

              {%- if rating != blank -%}
                {%- assign rating_full = rating.rating | floor -%}{%- assign rating_frac = rating.rating | minus: rating_full -%}
                <div class="product-row__rating">
                  <span class="product-row__stars" style="--full: {{ rating_full }}; --frac: {{ rating_frac }};" aria-label="{{ rating.rating }} / {{ rating.scale_max }}">
                    <span class="product-row__stars-fill">{% for i in (1..5) %}{{ star }}{% endfor %}</span>
                  </span>
                  <span class="product-row__rating-text">{{ rating.rating | round: 1 }}/<span>{{ rating.scale_max | round }}</span></span>
                </div>
              {%- endif -%}

              <div class="product-row__price">
                <span>{{ product.price | money_without_trailing_zeros }}</span>
                {%- if discount > 0 -%}
                  <s class="product-row__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                  <span class="product-row__badge">-{{ discount }}%</span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Primer-kartice dok se ne izabere kolekcija (kao u dizajnu) {%- endcomment -%}
        {%- assign demo_titles = 'T-shirt with Tape Details|Skinny Fit Jeans|Checkered Shirt|Sleeve Striped T-shirt' | split: '|' -%}
        {%- assign demo_prices = '$120|$240|$180|$130' | split: '|' -%}
        {%- assign demo_compare = '|$260||$160' | split: '|' -%}
        {%- assign demo_badges = '|-20%||-30%' | split: '|' -%}
        {%- assign demo_full = '4|3|4|4' | split: '|' -%}
        {%- assign demo_rating_text = '4.5|3.5|4.5|4.5' | split: '|' -%}
        {%- for i in (0..3) -%}
          {%- assign n = i | plus: 1 -%}
          <li class="product-row__card">
            <div class="product-row__media">
              {{ 'product-apparel-' | append: n | placeholder_svg_tag: 'product-row__img' }}
            </div>
            <h3 class="product-row__title">{{ demo_titles[i] }}</h3>
            <div class="product-row__rating">
              <span class="product-row__stars" style="--full: {{ demo_full[i] }}; --frac: 0.5;">
                <span class="product-row__stars-fill">{% for j in (1..5) %}{{ star }}{% endfor %}</span>
              </span>
              <span class="product-row__rating-text">{{ demo_rating_text[i] }}/<span>5</span></span>
            </div>
            <div class="product-row__price">
              <span>{{ demo_prices[i] }}</span>
              {%- if demo_compare[i] != blank -%}
                <s class="product-row__compare">{{ demo_compare[i] }}</s>
                <span class="product-row__badge">{{ demo_badges[i] }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if s.button_label != blank -%}
      {%- assign button_link = s.button_link | default: s.collection.url | default: '/collections/all' -%}
      <div class="product-row__actions">
        <a class="product-row__button" href="{{ button_link }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}

    {%- if s.show_divider -%}
      <hr class="product-row__divider">
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product-row__inner {
    width: min(1240px, 100% - 32px);
    margin: 0 auto;
    padding-top: 72px;
  }
  .product-row__heading {
    margin: 0 0 55px;
    font-family: var(--font-heading);
    font-stretch: 106%;
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    color: #000;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---------- Kartice ---------- */
  .product-row__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product-row__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .product-row__media {
    aspect-ratio: 295 / 298;
    margin-bottom: 16px;
    overflow: hidden;
    border-radius: 20px;
    background: #f0eeed;
  }
  .product-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-row__title {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    color: #000;
    text-transform: none;
  }

  /* Ocena: pune zvezdice (--full) + deo sledeće (--frac, npr. 0.5) */
  .product-row__rating {
    --star: 18px;
    --star-gap: 5px;
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 8px;
  }
  .product-row__stars {
    display: block;
    width: calc(5 * var(--star) + 4 * var(--star-gap));
  }
  .product-row__stars-fill {
    display: flex;
    gap: var(--star-gap);
    width: calc(var(--full) * (var(--star) + var(--star-gap)) + var(--frac) * var(--star));
    overflow: hidden;
    color: #ffc633;
  }
  .product-row__stars-fill svg {
    flex: 0 0 var(--star);
    width: var(--star);
    height: var(--star);
  }
  .product-row__rating-text {
    font-size: 14px;
    line-height: 1;
  }
  .product-row__rating-text span {
    color: #666;
  }

  .product-row__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 24px;
    font-weight: 700;
  }
  .product-row__compare {
    color: rgba(0, 0, 0, 0.4);
  }
  .product-row__badge {
    padding: 6px 14px;
    border-radius: 62px;
    background: rgba(255, 51, 51, 0.1);
    color: #f33;
    font-size: 12px;
    font-weight: 500;
  }

  /* ---------- Dugme i linija ---------- */
  .product-row__actions {
    margin-top: 36px;
    text-align: center;
  }
  .product-row__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 218px;
    height: 52px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 62px;
    color: #000;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
  }
  .product-row__divider {
    margin: 64px 0 0;
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .product-row__inner {
      padding-top: 50px;
    }
    .product-row__heading {
      margin-bottom: 32px;
      font-size: 32px;
    }
    /* Kartice u jednom redu, prevlačenje levo-desno */
    .product-row__list {
      display: flex;
      gap: 16px;
      margin-right: -16px;
      padding-right: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .product-row__card {
      flex: 0 0 198px;
      scroll-snap-align: start;
    }
    .product-row__media {
      aspect-ratio: 198 / 200;
      margin-bottom: 10px;
    }
    .product-row__title {
      margin-bottom: 4px;
      font-size: 16px;
    }
    .product-row__rating {
      --star: 15px;
      --star-gap: 4px;
      gap: 11px;
      margin-bottom: 4px;
    }
    .product-row__rating-text {
      font-size: 12px;
    }
    .product-row__price {
      gap: 5px;
      font-size: 20px;
    }
    .product-row__badge {
      padding: 4px 10px;
      font-size: 10px;
    }
    .product-row__actions {
      margin-top: 24px;
    }
    .product-row__button {
      width: 100%;
      height: 46px;
      font-size: 14px;
    }
    .product-row__divider {
      margin-top: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Proizvodi (red)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Naslov", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Kolekcija", "info": "Dok ne izabereš kolekciju, prikazuju se primer-kartice." },
    { "type": "range", "id": "products_count", "label": "Broj proizvoda", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Tekst dugmeta", "default": "View All", "info": "Ostavi prazno da sakriješ dugme." },
    { "type": "url", "id": "button_link", "label": "Link dugmeta", "info": "Ako je prazno, vodi na izabranu kolekciju." },
    { "type": "checkbox", "id": "show_divider", "label": "Linija ispod sekcije", "default": true }
  ],
  "presets": [
    { "name": "Proizvodi (red)" }
  ]
}
{% endschema %}
