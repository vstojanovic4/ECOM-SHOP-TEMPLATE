    }
    .pdp__lb-arrow {
      display: none;
    }
    .pdp__title {
      margin-bottom: 12px;
      font-size: 24px;
    }
    .pdp__rating {
      --star: 18px;
      --star-gap: 5px;
      gap: 11px;
      margin-bottom: 12px;
    }
    .pdp__rating-text {
      font-size: 14px;
    }
    .pdp__price {
      gap: 10px;
      margin-bottom: 20px;
      font-size: 24px;
    }
    .pdp__badge {
      padding: 6px 14px;
      font-size: 12px;
    }
    .pdp__description {
      padding-bottom: 24px;
      font-size: 14px;
      line-height: 20px;
    }
    .pdp__option {
      padding: 24px 0;
    }
    .pdp__option-label {
      font-size: 14px;
    }
    .pdp__swatches {
      gap: 12px;
    }
    .pdp__pills {
      gap: 8px;
