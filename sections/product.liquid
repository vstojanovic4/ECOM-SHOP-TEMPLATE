  }
  .pdp__plan-card:has(:checked)::before {
    border: 5px solid #000;
  }
  .pdp__plan-card:has(:focus-visible) {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
  .pdp__plan-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pdp__plan-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 500;
  }
  .pdp__plan-badge {
    padding: 4px 10px;
    font-size: 12px;
  }
  .pdp__plan-price {
    margin-left: auto;
    font-size: 18px;
    font-weight: 700;
  }
  .pdp__plan-options {
    margin: 16px 0 0;
    padding: 0;
    border: 0;
  }
  .pdp__plan-options[hidden] {
    display: none;
  }
  .pdp__plan-radio:checked + .pdp__pill {
    background: #000;
    color: #fff;
  }
  .pdp__plan-radio:focus-visible + .pdp__pill {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
  .pdp__qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 170px;
    height: 52px;
    padding: 0 16px;
    border-radius: 62px;
    background: #f0f0f0;
    flex-shrink: 0;
  }
  .pdp__qty-btn {
    display: flex;
    padding: 4px;
    border: 0;
    background: none;
    color: #000;
    cursor: pointer;
  }
  .pdp__qty-btn svg {
    width: 24px;
    height: 24px;
  }
  .pdp__qty-input {
    width: 40px;
    border: 0;
    border-radius: 0;
    background: none;
    font-size: 16px;
    font-weight: 500;
    text-align: center;
    -moz-appearance: textfield;
  }
  .pdp__qty-input::-webkit-inner-spin-button,
  .pdp__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }
  .pdp__add {
    flex: 1;
    height: 52px;
    border: 0;
    border-radius: 62px;
    background: #000;
    color: #fff;
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }
  .pdp__add:disabled {
    background: rgba(0, 0, 0, 0.3);
    cursor: not-allowed;
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .pdp__breadcrumbs {
      margin-bottom: 20px;
      font-size: 14px;
    }
    .pdp__breadcrumbs svg {
      width: 14px;
      height: 14px;
      margin: 0 2px;
    }
    .pdp__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .pdp__gallery {
      gap: 12px;
    }
    /* Telefon: prevlačenje prstom */
    .pdp__slides {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
    .pdp__slide {
      aspect-ratio: 358 / 290;
    }
    .pdp__slider .pdp__arrow {
      display: none;
    }
    .pdp__thumbs {
      gap: 12px;
    }
    .pdp__thumbs li {
      flex: 0 0 calc((100% - 24px) / 3);
