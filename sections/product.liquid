{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-pdp]').forEach((pdp) => {
    const variants = JSON.parse(pdp.querySelector('[data-variants]').textContent);
    const [addLabel, soldOutLabel, unavailableLabel] = JSON.parse(pdp.querySelector('[data-labels]').textContent);
    const form = pdp.querySelector('.pdp__form');
    const idInput = pdp.querySelector('[data-variant-id]');
    const addButton = pdp.querySelector('[data-add]');

    // ---------- Galerija ----------
    // Beskonačna petlja: na početak se doda kopija poslednje slike, a na kraj kopija prve.
    // Kad slajder stigne na kopiju, neprimetno skoči na pravu sliku, pa se uvek može ići u istu stranu.
    const makeLoop = (track, onChange) => {
      const count = track.children.length;
      const state = { index: 0, count, goTo: () => {} };
      if (count < 2) return state;

      const cloneOf = (slide) => {
        const clone = slide.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        clone.dataset.clone = '';
        clone.querySelectorAll('button, a').forEach((el) => el.setAttribute('tabindex', '-1'));
        clone.querySelectorAll('img').forEach((img) => img.setAttribute('loading', 'eager'));
        return clone;
      };
      track.prepend(cloneOf(track.lastElementChild));
      track.append(cloneOf(track.children[1]));

      const width = () => track.clientWidth;
      const jump = (position) => {
        track.style.scrollBehavior = 'auto';
        track.style.scrollSnapType = 'none';
        track.scrollLeft = position * width();
        track.offsetHeight; // primeni odmah, pa vrati snap
        track.style.scrollSnapType = '';
        track.style.scrollBehavior = '';
      };
      const settle = () => {
        let position = Math.round(track.scrollLeft / width());
        if (position === 0) {
          position = count;
          jump(position);
        } else if (position === count + 1) {
          position = 1;
          jump(position);
        }
        const index = position - 1;
        if (index !== state.index) {
          state.index = index;
          onChange(index);
        }
      };

      // index može biti -1 ili count (kopije), petlja to sama ispravi posle animacije
      state.goTo = (index, smooth = true) => {
        track.scrollTo({ left: (index + 1) * width(), behavior: smooth ? 'smooth' : 'auto' });
        if (!smooth) settle();
      };

      let timer;
      track.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = setTimeout(settle, 90);
      });
      window.addEventListener('resize', () => jump(state.index + 1));
      jump(1);
      return state;
    };

    const gallery = pdp.querySelector('[data-gallery]');
    const slides = gallery.querySelector('[data-slides]');
    const thumbsList = gallery.querySelector('.pdp__thumbs');

    // Aktivna sličica; red sličica se pomera samo levo-desno (strana ostaje gde jeste)
    const markThumb = (index) => {
      gallery.querySelectorAll('[data-thumb]').forEach((thumb) => {
        const active = Number(thumb.dataset.thumb) === index;
        thumb.classList.toggle('is-active', active);
        if (active) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
        if (active && thumbsList) {
          const item = thumb.parentElement;
          const left = item.offsetLeft - thumbsList.offsetLeft;
          if (left < thumbsList.scrollLeft || left + item.offsetWidth > thumbsList.scrollLeft + thumbsList.clientWidth) {
            thumbsList.scrollTo({ left, behavior: 'smooth' });
          }
        }
      });
    };

    const main = makeLoop(slides, markThumb);
    markThumb(0);

    // Desktop: klik na sličice i strelice (telefon: prevlačenje, isto preko makeLoop)
    gallery.querySelectorAll('[data-thumb]').forEach((thumb) =>
      thumb.addEventListener('click', () => main.goTo(Number(thumb.dataset.thumb)))
    );
    gallery.querySelector('[data-slide-prev]')?.addEventListener('click', () => main.goTo(main.index - 1));
    gallery.querySelector('[data-slide-next]')?.addEventListener('click', () => main.goTo(main.index + 1));

    // Varijanta sa svojom slikom: prebaci slajder na nju
    const showMedia = (mediaId) => {
      if (!mediaId) return;
      const slide = slides.querySelector(`[data-media-id="${mediaId}"]:not([data-clone])`);
      if (slide) main.goTo(Number(slide.dataset.index));
    };

    // ---------- Zoom preko celog ekrana ----------
    const lightbox = gallery.querySelector('[data-lightbox]');
    if (lightbox) {
      const lbSlides = lightbox.querySelector('[data-lb-slides]');
      const counter = lightbox.querySelector('[data-lb-counter]');

      const resetZoom = () => {
        lightbox.classList.remove('is-zoomed');
        lightbox.querySelectorAll('[data-zoom-frame]').forEach((frame) => frame.classList.remove('is-zoomed'));
      };
      const lb = makeLoop(lbSlides, (index) => {
        resetZoom();
        if (counter) counter.textContent = `${index + 1} / ${lb.count}`;
      });

      // Klik na glavnu sliku (i na kopije u petlji) otvara zoom na toj slici
      gallery.querySelectorAll('[data-zoom-open]').forEach((trigger) =>
        trigger.addEventListener('click', () => {
          lightbox.showModal();
          lb.goTo(Number(trigger.dataset.zoomOpen), false);
          if (counter) counter.textContent = `${lb.index + 1} / ${lb.count}`;
        })
      );

      // Desktop: strelice i tasteri ← →
      lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', () => lb.goTo(lb.index - 1));
      lightbox.querySelector('[data-lb-next]')?.addEventListener('click', () => lb.goTo(lb.index + 1));
      lightbox.addEventListener('keydown', (event) => {
        if (lightbox.classList.contains('is-zoomed')) return;
        if (event.key === 'ArrowLeft') lb.goTo(lb.index - 1);
        if (event.key === 'ArrowRight') lb.goTo(lb.index + 1);
      });

      lightbox.querySelector('[data-lb-close]').addEventListener('click', () => lightbox.close());
      // Kad se zoom zatvori, glavni slajder pokazuje poslednju gledanu sliku
      lightbox.addEventListener('close', () => {
        resetZoom();
        main.goTo(lb.index, false);
      });

      // Klik na sliku u zoomu: uvećaj 2× na mestu klika / vrati
      lightbox.querySelectorAll('[data-zoom-frame]').forEach((frame) => {
        frame.addEventListener('click', (event) => {
          const zoomIn = !frame.classList.contains('is-zoomed');
          frame.classList.toggle('is-zoomed', zoomIn);
          lightbox.classList.toggle('is-zoomed', zoomIn);
          if (zoomIn) {
            const rect = frame.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width;
            const y = (event.clientY - rect.top) / rect.height;
            frame.scrollLeft = x * frame.scrollWidth - rect.width / 2;
            frame.scrollTop = y * frame.scrollHeight - rect.height / 2;
          }
        });
        // Desktop: pomeranje miša pomera uvećanu sliku (telefon pomera prstom)
        frame.addEventListener('mousemove', (event) => {
          if (!frame.classList.contains('is-zoomed')) return;
          const rect = frame.getBoundingClientRect();
          frame.scrollLeft = ((event.clientX - rect.left) / rect.width) * (frame.scrollWidth - rect.width);
          frame.scrollTop = ((event.clientY - rect.top) / rect.height) * (frame.scrollHeight - rect.height);
        });
      });
    }

    // Količina: dugmad - i +
    const qtyInput = pdp.querySelector('.pdp__qty-input');
    pdp.querySelectorAll('[data-qty]').forEach((button) => {
      button.addEventListener('click', () => {
        const next = (parseInt(qtyInput.value, 10) || 1) + parseInt(button.dataset.qty, 10);
        qtyInput.value = Math.max(1, next);
      });
    });

    // Subscriptions: one-time or a selling plan; the hidden selling_plan input is sent only when subscribing
    const plans = pdp.querySelector('[data-plans]');
    let currentVariant = variants.find((v) => String(v.id) === idInput.value);
    const updatePlans = () => {
      if (!plans) return;
      const subscribe = plans.querySelector('[data-purchase-type]:checked')?.value === 'subscribe';
      const plan = plans.querySelector('[data-plan-radio]:checked');
      const planInput = plans.querySelector('[data-plan-input]');
      plans.querySelector('[data-plan-options]').hidden = !subscribe;
      planInput.disabled = !subscribe || !plan;
      if (plan) planInput.value = plan.value;

      if (!currentVariant) return;
      const oncePrice = plans.querySelector('[data-once-price]');
      if (oncePrice) oncePrice.textContent = currentVariant.price;
      plans.querySelector('[data-plan-price]').textContent = (plan && currentVariant.plans[plan.value]) || currentVariant.price;
    };
    plans?.addEventListener('change', updatePlans);

    // Opcije: pronađi varijantu koja odgovara izabranim vrednostima
    form.addEventListener('change', (event) => {
      if (!event.target.classList.contains('pdp__radio')) return;

      // Opcije mogu biti prikazane drugim redom nego u adminu, pa se slažu po data-option-index
      const selected = [];
      form.querySelectorAll('.pdp__option').forEach((fieldset) => {
        selected[fieldset.dataset.optionIndex] = fieldset.querySelector('.pdp__radio:checked')?.value;
      });
      const variant = variants.find((v) => v.options.every((value, i) => value === selected[i]));

      if (!variant) {
        addButton.disabled = true;
        addButton.textContent = unavailableLabel;
        return;
      }

      idInput.value = variant.id;
      currentVariant = variant;
      updatePlans();
      // Let app blocks (subscriptions) know the variant changed, so they show its prices
      idInput.dispatchEvent(new Event('change', { bubbles: true }));
      addButton.disabled = !variant.available;
      addButton.textContent = variant.available ? addLabel : soldOutLabel;

      pdp.querySelector('[data-price]').textContent = variant.price;
      const compare = pdp.querySelector('[data-compare]');
      const badge = pdp.querySelector('[data-badge]');
      compare.hidden = badge.hidden = variant.discount === 0;
      compare.textContent = variant.compare;
      badge.textContent = `-${variant.discount}%`;

      showMedia(variant.media);

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    { "type": "text", "id": "color_label", "label": "Colors heading", "default": "Select Colors" },
    { "type": "text", "id": "size_label", "label": "Sizes heading", "default": "Choose Size" },
    { "type": "text", "id": "add_label", "label": "Button text", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out text", "default": "Sold out" },
    { "type": "text", "id": "unavailable_label", "label": "Unavailable combination text", "default": "Unavailable" }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
