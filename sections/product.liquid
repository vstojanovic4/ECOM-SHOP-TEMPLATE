    .pdp__pill {
      height: 39px;
      padding: 0 20px;
      font-size: 14px;
    }
    .pdp__buy {
      gap: 12px;
    }
    .pdp__qty {
      width: 110px;
      height: 44px;
      padding: 0 12px;
    }
    .pdp__qty-btn svg {
      width: 20px;
      height: 20px;
