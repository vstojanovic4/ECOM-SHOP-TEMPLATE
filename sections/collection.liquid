    font-weight: 500;
    text-decoration: none;
  }
  .plp__page-btn svg {
    width: 20px;
    height: 20px;
  }
  .plp__page-btn.is-disabled {
    opacity: 0.4;
  }
  .plp__pages {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plp__page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    border-radius: 8px;
    color: rgba(0, 0, 0, 0.5);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .plp__page.is-current {
    background: rgba(0, 0, 0, 0.06);
    color: #000;
  }

  .plp__overlay {
    display: none;
  }

  /* ---------- MOBILNI ---------- */
  @media (max-width: 989px) {
    .plp__inner {
      padding-bottom: 50px;
    }
    .plp__breadcrumbs {
      margin-bottom: 16px;
      font-size: 14px;
    }
    .plp__layout {
      grid-template-columns: 1fr;
    }

    /* Filteri kao panel koji izlazi odozdo */
    .plp__filters {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      max-height: 85vh;
      overflow-y: auto;
      border-radius: 20px 20px 0 0;
      transform: translateY(100%);
      transition: transform 0.3s ease;
    }
    .plp.is-filters-open .plp__filters {
      transform: none;
    }
    .plp__overlay {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: block;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .plp.is-filters-open .plp__overlay {
      opacity: 1;
      pointer-events: auto;
    }
    .plp__filters-icon {
      display: none;
    }
    .plp__filters-close {
      display: flex;
      padding: 0;
      border: 0;
      background: none;
      color: rgba(0, 0, 0, 0.4);
      cursor: pointer;
    }
    .plp__filters-close svg {
      width: 24px;
      height: 24px;
    }

    .plp__head {
      flex-wrap: wrap;
      align-items: flex-end;
    }
    .plp__title {
      font-size: 24px;
    }
    .plp__meta {
      order: 3;
      flex-basis: 100%;
      justify-content: space-between;
      font-size: 14px;
    }
    .plp__open-filters {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #f0f0f0;
      color: #000;
      cursor: pointer;
    }
    .plp__open-filters svg {
      width: 16px;
      height: 16px;
    }

    .plp__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 14px;
      padding-bottom: 24px;
    }
    .plp__page-btn {
      padding: 0 10px;
      font-size: 12px;
    }
    .plp__page {
      min-width: 32px;
      height: 32px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-plp]').forEach((plp) => {
    // Mobilni: otvaranje i zatvaranje filtera
    plp.querySelectorAll('[data-plp-open]').forEach((button) =>
      button.addEventListener('click', () => plp.classList.add('is-filters-open'))
    );
    plp.querySelectorAll('[data-plp-close]').forEach((button) =>
      button.addEventListener('click', () => plp.classList.remove('is-filters-open'))
    );

    // Sortiranje: menja ?sort_by= u adresi i zadržava filtere
    plp.querySelector('[data-plp-sort]')?.addEventListener('change', (event) => {
      const url = new URL(window.location.href);
      url.searchParams.set('sort_by', event.target.value);
      url.searchParams.delete('page');
      window.location.href = url.toString();
    });

    // Cena: dva klizača ne smeju da se preklope, natpisi i linija prate vrednosti
    plp.querySelectorAll('[data-price-range]').forEach((range) => {
      const min = range.querySelector('[data-price-min]');
      const max = range.querySelector('[data-price-max]');
      const minLabel = range.querySelector('[data-price-min-label]');
      const maxLabel = range.querySelector('[data-price-max-label]');
      const symbol = minLabel.textContent.replace(/[\d.,\s]/g, '');

      const update = (changed) => {
        if (Number(min.value) > Number(max.value)) {
          if (changed === min) min.value = max.value;
          else max.value = min.value;
        }
        range.style.setProperty('--min', min.value);
        range.style.setProperty('--max', max.value);
        minLabel.textContent = symbol + min.value;
        maxLabel.textContent = symbol + max.value;
      };
      min.addEventListener('input', () => update(min));
      max.addEventListener('input', () => update(max));
    });

    // Ne šalji filter cene ako nije pomeren (da adresa ostane čista)
    plp.querySelector('.plp__filter-form')?.addEventListener('submit', (event) => {
      event.target.querySelectorAll('[data-price-range]').forEach((range) => {
        const min = range.querySelector('[data-price-min]');
        const max = range.querySelector('[data-price-max]');
        if (Number(min.value) === 0) min.disabled = true;
        if (Number(max.value) === Number(max.max)) max.disabled = true;
      });
    });
  });
{% endjavascript %}

{% schema %}
