  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Proizvoda po strani", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "link_list", "id": "category_menu", "label": "Meni kategorija (gore u filterima)", "info": "Opciono. Ako je prazno, kategorije su tagovi proizvoda koji nisu stilovi (T-Shirt, Jeans...)." },
    { "type": "text", "id": "style_tags", "label": "Tagovi koji su stilovi", "default": "Casual,Formal,Party,Gym", "info": "Odvojeni zarezom. Ovi tagovi idu u grupu Dress Style, ostali tagovi su kategorije na vrhu." },
    { "type": "text", "id": "style_label", "label": "Naslov za stilove", "default": "Dress Style" },
