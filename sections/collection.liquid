  /* ---------- Stranice ---------- */
  .plp__pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
  }
  .plp__page-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    color: #000;
